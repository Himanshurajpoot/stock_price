# Stock Price Predictor Configuration
# Copy this to .env and modify values as needed

# Model Parameters
XGB_N_ESTIMATORS=300
XGB_LEARNING_RATE=0.05
XGB_MAX_DEPTH=4

# Prophet Parameters
PROPHET_INTERVAL_WIDTH=0.95

# Anomaly Detection
ENABLE_ANOMALY_DETECTION=true
ANOMALY_THRESHOLD=2.5

# Backtest Parameters
INITIAL_CAPITAL=100000
TRANSACTION_COST=0.001

# Database (Optional)
DATABASE_URL=

# Logging
LOG_LEVEL=INFO

# API (Optional)
ENABLE_API=false
API_HOST=0.0.0.0
API_PORT=8000
